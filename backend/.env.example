APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Google Maps (all maps use Google). Leave empty: everything falls back gracefully and lights up when set.
# Browser key -> enable "Maps JavaScript API", "Places API (New)" and "Maps Embed API" only.
#   Restrict it by HTTP referrer (Application restrictions > Websites), e.g. https://admin.example.com/*
#   and the API restrictions to those three APIs. It is visible in admin page source by design.
#   Used by the admin location picker (map, draggable marker, Places autocomplete).
GOOGLE_MAPS_BROWSER_KEY=
# Server key -> enable "Routes API" only. Restrict it by IP address (the server's public IP)
#   and the API restriction to Routes API. Never exposed to browsers. Used for transfer road distances.
GOOGLE_MAPS_SERVER_KEY=
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
# Lifetime in minutes of the "Welcome, set your password" link e-mailed to customers created by staff (default 7 days).
AUTH_WELCOME_TOKEN_EXPIRE=10080

# Website on-demand revalidation: the admin POSTs {"tags": [...]} here after content changes, with the
# header x-revalidate-secret. Use the same random secret (e.g. `openssl rand -hex 32`) in the frontend .env.local.
FRONTEND_REVALIDATE_URL=http://127.0.0.1:3100/api/revalidate
FRONTEND_REVALIDATE_SECRET=

# Payments (SRS 10): no real keys ship. An online gateway is offered to customers only when its keys are set.
# "fake" gateway (local only; off when APP_ENV=production unless PAYMENT_FAKE_ENABLED=true) signs webhooks with this secret.
PAYMENT_FAKE_ENABLED=true
PAYMENT_FAKE_WEBHOOK_SECRET=fake-webhook-secret
# Customer return page after checkout; {locale} and {reference} are replaced, ?token=…&payment=success|cancel is appended.
PAYMENT_RETURN_URL="http://localhost:3000/{locale}/booking/{reference}"
PAYMENT_PROOFS_DISK=local
# Stripe Checkout: sk_test_… = test mode. Webhook endpoint: {APP_URL}/api/v1/payments/webhooks/stripe with events
# checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, checkout.session.expired.
# Local test: `stripe listen --forward-to http://127.0.0.1:8090/api/v1/payments/webhooks/stripe` prints the whsec_… secret.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# PayPal Orders v2 (REST): PAYPAL_MODE=sandbox|live. Webhook endpoint: {APP_URL}/api/v1/payments/webhooks/paypal with events
# CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED; PAYPAL_WEBHOOK_ID is the id of that webhook.
# The buyer returns to {APP_URL}/api/v1/payments/paypal/return, which captures the order and redirects to the booking page.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
# Exchange rates (SRS 11): keyless API, rates relative to EUR. Interval and manual rates are set in the admin.
EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest/EUR

# Transfers (SRS 5): "auto" = Google Routes API when GOOGLE_MAPS_SERVER_KEY is set, else the offline
# Haversine distance x road factor (flagged as estimated for admin review). "haversine" forces the estimate.
TRANSFER_DISTANCE_DRIVER=auto
TRANSFER_ROAD_FACTOR=1.3
TRANSFER_AVERAGE_SPEED_KMH=60
TRANSFER_ROUNDING_STEP=1
TRANSFER_QUOTE_VALIDITY_MINUTES=60
