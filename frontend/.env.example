# Base URL of the Laravel API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8090/api/v1
# Force mock data (true) instead of calling the API. When unset/false the
# client calls the API and falls back to mocks if it is unreachable.
NEXT_PUBLIC_USE_MOCKS=false
# Public URL of this site, used for canonical/hreflang/sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number in international format, digits only
NEXT_PUBLIC_WHATSAPP_NUMBER=201234567890
# Google Business Profile "write a review" URL
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=ChIJ_sharm_station_demo
# Server-side only: direct API URL used during rendering (skips DNS/proxy)
API_INTERNAL_URL=http://127.0.0.1:8090/api/v1
# Google Maps browser key (public, shipped to the browser). Restrict it by HTTP referrer
# (e.g. https://www.example.com/*, http://localhost:3100/*) and enable only:
# Maps JavaScript API, Places API (New), Maps Embed API.
# Empty: single locations use the keyless Google Maps embed, multi-place maps fall back to
# an embed of the area plus a text list, and transfer drop-off search uses the site's own list.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID (Google Cloud console > Map management). Enables Advanced Markers.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server-side only: shared secret for POST /api/revalidate (header x-revalidate-secret),
# called by the Laravel admin after content changes. Same value as the backend setting.
REVALIDATE_SECRET=
